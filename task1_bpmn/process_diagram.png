<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Процесс выдачи IT-оборудования (AS-IS)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_GetNumber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CatchEvent_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Rate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RateMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_User</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_User_Rate</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_TP" name="1-я линия ТП">
        <bpmn:flowNodeRef>Task_TP_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TP_CreateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TP_Issue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TP_Close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Supply" name="Отдел снабжения">
        <bpmn:flowNodeRef>Task_Supply_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supply_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supply_OrderVendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supply_AcceptEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Supply_CallLogistics</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Vendor" name="Поставщик">
        <bpmn:flowNodeRef>ReceiveTask_Vendor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Vendor_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Logistics" name="Логистика">
        <bpmn:flowNodeRef>Task_Logistics_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Возникла потребность в IT-оборудовании">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_User_Submit" name="Подаёт заявку (почта / телефон)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TP_Register" name="Регистрирует обращение в Системе №1 и выдаёт номер">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="CatchEvent_GetNumber" name="Получает номер обращения">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_GetNumber" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_TP_CreateRequest" name="Создаёт заявку на оборудование в Системе №2">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Supply_Accept" name="Принимает заявку в Системе №2 (почта + ЛК)">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Supply_Check" name="Проверяет наличие в Системе №3">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Available" name="Оборудование есть?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Supply_OrderVendor" name="Направляет заявку на закупку поставщику (почта)">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ReceiveTask_Vendor" name="Получает заявку на закупку">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Task_Supply_AcceptEquip" name="Проводит приём оборудования в Системе №3">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Supply_CallLogistics" name="Вызывает логистику">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Logistics_Deliver" name="Доставляет оборудование в 1-ю линию ТП">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TP_Issue" name="Выдаёт оборудование пользователю">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_TP_Close" name="Закрывает заявку в Системе №1 и Системе №2">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="CatchEvent_Receive" name="Получает оборудование">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageDef_Receive" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Rate" name="Хочет оценить?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_RateMerge">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_User" name="Заявка завершена">
      <bpmn:incoming>Flow_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_System1" name="Система №1 (обращения)" />
    <bpmn:dataStoreReference id="DataStore_System2" name="Система №2 (заявки на оборудование)" />
    <bpmn:dataStoreReference id="DataStore_System3" name="Система №3 (склад / каталог)" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_User_Submit" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_User_Submit" targetRef="Task_TP_Register" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_TP_Register" targetRef="CatchEvent_GetNumber" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="CatchEvent_GetNumber" targetRef="Task_TP_CreateRequest" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_TP_CreateRequest" targetRef="Task_Supply_Accept" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Supply_Accept" targetRef="Task_Supply_Check" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Supply_Check" targetRef="Gateway_Available" />
    <bpmn:sequenceFlow id="Flow_8" name="Да" sourceRef="Gateway_Available" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_9" name="Нет" sourceRef="Gateway_Available" targetRef="Task_Supply_OrderVendor" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Supply_OrderVendor" targetRef="ReceiveTask_Vendor" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ReceiveTask_Vendor" targetRef="Task_Vendor_Deliver" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Vendor_Deliver" targetRef="Task_Supply_AcceptEquip" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Supply_AcceptEquip" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Gateway_Merge" targetRef="Task_Supply_CallLogistics" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Supply_CallLogistics" targetRef="Task_Logistics_Deliver" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Logistics_Deliver" targetRef="Task_TP_Issue" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_TP_Issue" targetRef="Task_TP_Close" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_TP_Close" targetRef="CatchEvent_Receive" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="CatchEvent_Receive" targetRef="Gateway_Rate" />
    <bpmn:sequenceFlow id="Flow_20" name="Да" sourceRef="Gateway_Rate" targetRef="Task_User_Rate" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_User_Rate" targetRef="Gateway_RateMerge" />
    <bpmn:sequenceFlow id="Flow_22" name="Нет" sourceRef="Gateway_Rate" targetRef="Gateway_RateMerge" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_RateMerge" targetRef="EndEvent_User" />
    <bpmn:userTask id="Task_Vendor_Deliver" name="Доставляет оборудование">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_User_Rate" name="Выставляет оценку сервиса ТП">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:association id="Assoc_TP_Register_S1" sourceRef="Task_TP_Register" targetRef="DataStore_System1" />
    <bpmn:association id="Assoc_TP_Create_S2" sourceRef="Task_TP_CreateRequest" targetRef="DataStore_System2" />
    <bpmn:association id="Assoc_S2_Supply_Accept" sourceRef="DataStore_System2" targetRef="Task_Supply_Accept" />
    <bpmn:association id="Assoc_S3_Supply_Check" sourceRef="DataStore_System3" targetRef="Task_Supply_Check" />
    <bpmn:association id="Assoc_Supply_AcceptEquip_S3" sourceRef="Task_Supply_AcceptEquip" targetRef="DataStore_System3" />
    <bpmn:association id="Assoc_TP_Close_S1" sourceRef="Task_TP_Close" targetRef="DataStore_System1" />
    <bpmn:association id="Assoc_TP_Close_S2" sourceRef="Task_TP_Close" targetRef="DataStore_System2" />
  </bpmn:process>
